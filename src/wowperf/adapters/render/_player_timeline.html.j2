{# ABOUTME: One player's run as an SVG: pull bands, damage bars, and a row per cooldown. #}
{# ABOUTME: Prints coordinates computed in the domain; no arithmetic happens here. #}
{% macro player_timeline(timeline) %}
{% if timeline and timeline.section.state.value == "withheld" %}
<p class="withheld">{{ timeline.section.reason }}</p>
{% elif timeline %}
<svg class="player-timeline" viewBox="0 0 {{ timeline.width }} {{ timeline.height }}">
  <title>{{ timeline.title }}</title>
  {% for x, label in timeline.ticks %}
  <line class="tick" x1="{{ x }}" y1="{{ timeline.tick_y1 }}" x2="{{ x }}" y2="{{ timeline.tick_y2 }}"/>
  <text class="tick-label" x="{{ x }}" y="{{ timeline.tick_label_y }}" text-anchor="middle">{{ label }}</text>
  {% endfor %}
  {% for band in timeline.pulls %}
  <rect class="{{ band.css_class }}" x="{{ band.x }}" y="{{ timeline.band_y }}"
        width="{{ band.width }}" height="{{ timeline.column_height }}"><title>{{ band.label }}</title></rect>
  {% if band.is_boss and band.label %}
  <text class="pull-name" x="{{ band.x }}" y="{{ timeline.pull_label_y }}">{{ band.label }}</text>
  {% endif %}
  {% endfor %}
  {% if timeline.damage %}
  <line class="damage-axis" x1="{{ timeline.damage.axis_x0 }}" y1="{{ timeline.damage.axis_top_y }}"
        x2="{{ timeline.damage.axis_x1 }}" y2="{{ timeline.damage.axis_top_y }}"/>
  <text class="tick-label row-label" x="{{ timeline.label_x }}"
        y="{{ timeline.damage.axis_top_y }}">{{ timeline.damage.axis_top_label }}</text>
  {% for bar in timeline.damage.bars %}
  <rect class="damage-bar" x="{{ bar.x }}" y="{{ bar.y }}" width="{{ bar.width }}" height="{{ bar.height }}"/>
  {% endfor %}
  <text class="track-label row-label" x="{{ timeline.label_x }}" y="{{ timeline.damage.label_y }}">Damage taken</text>
  {% endif %}
  {% for row in timeline.cooldowns %}
  {% for span in row.unavailable %}
  <rect class="on-cooldown" x="{{ span.x }}" y="{{ row.baseline_y }}" width="{{ span.width }}" height="{{ timeline.row_height }}"/>
  {% endfor %}
  {% if row.not_judged %}
  <rect class="not-judged" x="{{ row.not_judged.x }}" y="{{ row.baseline_y }}" width="{{ row.not_judged.width }}" height="{{ timeline.row_height }}"/>
  {% endif %}
  {% for span in row.cover %}
  <rect class="cover" x="{{ span.x }}" y="{{ row.baseline_y }}"
        width="{{ span.width }}" height="{{ timeline.row_height }}"/>
  {% endfor %}
  {% for press in row.presses %}
  {% if row.ability_id in icons_by_id %}
  <use href="#icon-{{ row.ability_id }}" x="{{ press.icon_x }}" y="{{ row.baseline_y }}" width="{{ timeline.row_height }}" height="{{ timeline.row_height }}"/>
  {% endif %}
  <rect class="press" x="{{ press.x }}" y="{{ row.baseline_y }}" width="{{ timeline.press_width }}" height="{{ timeline.row_height }}"/>
  {% endfor %}
  {% for tick in row.ready_ticks %}
  <rect class="ready-again" x="{{ tick }}" y="{{ row.baseline_y }}"
        width="{{ timeline.press_width }}" height="{{ timeline.row_height }}"/>
  {% endfor %}
  <text class="track-label row-label" x="{{ timeline.label_x }}" y="{{ row.label_y }}">{{ row.label }}</text>
  {% endfor %}
</svg>
{% if timeline.damage %}<p class="sub">{{ timeline.damage.peak_label }} {{ timeline.damage.bucket_caption }}</p>{% endif %}
<p class="legend">{{ timeline.legend }}</p>
<p class="legend">{% if timeline.badge_measured %}<a class="badge {{ timeline.badge_measured.tint }}" href="#provenance">{{ timeline.badge_measured.label }}</a> — {{ timeline.badge_measured_caption }}{% endif %}{% if timeline.badge_inferred %} <a class="badge {{ timeline.badge_inferred.tint }}" href="#provenance">{{ timeline.badge_inferred.label }}</a> — {{ timeline.badge_inferred_caption }}{% endif %}</p>
{% endif %}
{% endmacro %}
