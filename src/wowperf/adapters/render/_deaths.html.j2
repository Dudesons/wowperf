{# ABOUTME: The Deaths panel: a health curve and a recap per death, the death costs below. #}
{# ABOUTME: A recap says what was pressed and what was ready, never what should have been. #}
{% from "_macros.html.j2" import ability, ledger_row with context %}
{% macro health_curve(curve, rows) %}
<div class="hp-pinned">
<svg class="hp-curve" width="100%" viewBox="0 0 {{ curve.width }} {{ curve.height }}">
  <title>Health through the seconds before the death</title>
  {% for guide in curve.guides %}
  <line class="hp-guide" x1="{{ curve.plot_x0 }}" y1="{{ guide.y }}"
        x2="{{ curve.plot_x1 }}" y2="{{ guide.y }}"></line>
  <text class="hp-axis hp-health" x="{{ curve.label_x }}" y="{{ guide.y }}">{{ guide.label }}</text>
  {% endfor %}
  {% for tick in curve.ticks %}
  <text class="hp-axis hp-time" x="{{ tick.x }}" y="{{ curve.tick_label_y }}">{{ tick.label }}</text>
  {% endfor %}
  {% for row in rows %}
  {% if row.cover_width is not none %}
  <rect class="hp-cover" id="{{ row.marker_id }}-cover"
        x="{{ row.cover_x }}" y="{{ curve.plot_y0 }}"
        width="{{ row.cover_width }}" height="{{ curve.plot_height }}"></rect>
  {% endif %}
  {% endfor %}
  <polyline class="hp-line" points="
    {%- for point in curve.points %}
    {{ point.x }},{{ point.y }}
    {%- endfor %}"></polyline>
  {% for reading in curve.readings %}
  <circle class="hp-reading" cx="{{ reading.x }}" cy="{{ reading.y }}" r="3.5">
    <title>{{ reading.percent }}% stated by the log</title>
  </circle>
  {% endfor %}
  {% for row in rows %}
  {% if row.marker_x is not none %}
  <line class="hp-marker" id="{{ row.marker_id }}-mark"
        x1="{{ row.marker_x }}" y1="{{ curve.plot_y0 }}"
        x2="{{ row.marker_x }}" y2="{{ curve.plot_y1 }}"></line>
  {% endif %}
  {% endfor %}
</svg>
{% if curve.reading_legend %}
<p class="legend">{{ curve.reading_legend }}
  {%- if curve.reading_badge %} <a class="badge {{ curve.reading_badge.tint }}"
     href="#provenance">{{ curve.reading_badge.label }}</a>{% endif %}</p>
{% endif %}
<p class="legend">{{ curve.line_legend }}
  {%- if curve.line_badge %} <a class="badge {{ curve.line_badge.tint }}"
     href="#provenance">{{ curve.line_badge.label }}</a>{% endif %}</p>
</div>
{% endmacro %}
<section class="panel" data-tab-panel="main" id="tab-deaths">

<h2 id="deaths">Deaths</h2>
{% if not report.deaths %}
<p class="sub">No deaths.</p>
{% endif %}
{% for death in report.deaths %}
<div class="card">
  <div class="row-head">
    <h3>{{ ability(death.killing_blow_id, death.killing_blow) }} — {{ death.player }}</h3>
    <span class="death-when">{{ death.when }}</span>
  </div>
  <p class="detail">{{ death.class_name }}</p>
  {% if death.health_curve %}
  {{ health_curve(death.health_curve, death.timeline) }}
  {% endif %}
  <div class="recap">
    <div class="recap-timeline">
      {% if death.timeline %}
      <details class="events">
      <summary>{{ death.timeline_summary }}</summary>
      <table class="timeline">
        <thead><tr><th>Before</th><th>Event</th><th>Detail</th><th>Health</th></tr></thead>
        <tbody>
        {% for row in death.timeline %}
        <tr class="{{ row.kind }}"{% if row.marker_id %} id="{{ row.marker_id }}" tabindex="0"{% endif %}>
          <td>{{ row.seconds_before }}</td>
          <td>{{ ability(row.ability_id, row.ability, row.tooltip) }}</td>
          <td>{{ row.detail }}</td>
          <td class="hp">
            {%- if row.health_percent is not none %}<span class="hp-bar" style="width: {{ row.health_percent }}%"></span>{% endif -%}
            {{ row.health }}</td>
        </tr>
        {% endfor %}
        </tbody>
      </table>
      {% if death.health_badge %}
      <p class="nests">Health after each event
        <a class="badge {{ death.health_badge.tint }}" href="#provenance">{{ death.health_badge.label }}</a></p>
      {% endif %}
      </details>
      {% elif death.timeline_note %}
      <p class="sub">{{ death.timeline_note }}</p>
      {% endif %}
      {% if death.health_note %}
      <p class="nests">{{ death.health_note }}</p>
      {% endif %}
      {% if death.came_back %}
      <p class="detail">{{ death.came_back }}
        {%- if death.came_back_badge %} <a class="badge {{ death.came_back_badge.tint }}"
           href="#provenance">{{ death.came_back_badge.label }}</a>{% endif %}</p>
      {% endif %}
    </div>
    <div class="recap-availability">
      {% for group in death.availability %}
      <div class="avail">
        <p class="avail-title">{{ group.title }}
          {%- if group.badge %} <a class="badge {{ group.badge.tint }}"
             href="#provenance">{{ group.badge.label }}</a>{% endif %}</p>
        {% if group.rows %}
        <ul>
          {% for row in group.rows %}
          <li class="{{ row.state }}">
            <span class="avail-name">{{ ability(row.ability_id, row.ability, row.tooltip) }}
              {%- if row.owner %} <span class="owner">{{ row.owner }}</span>{% endif %}</span>
            <span class="avail-detail">{{ row.detail }}</span>
          </li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if group.note %}
        <p class="nests">{{ group.note }}</p>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endfor %}

{% if report.death_rows %}
<p class="sub">Not additive — every figure below can already contain another, so they must
never be summed.</p>
<div class="findings">
{% for row in report.death_rows %}
{{ ledger_row(row) }}
{% endfor %}
</div>
{% endif %}

</section>
