{# ABOUTME: The two shapes a finding takes on the page: a full card, and a link to one. #}
{# ABOUTME: Each renders whichever fields it is handed; build.py decided what they hold. #}
{# `scope` prefixes every id and every fragment link these macros draw. A page that
   renders one report leaves it unset, which renders as nothing and names the card
   `finding-<id>` as it always has. The night page renders many reports into one
   document and sets it per pull: finding ids are unique inside one pull's report and
   repeat across pulls, because every pull draws from the same analysers, so without a
   prefix two pulls would carry the same element id and a pointer would open whichever
   the browser reached first. #}
{% macro ledger_row(row) %}
{% if row.group_note %}
<p class="group-note">{{ row.group_note }}</p>
{% endif %}
<div class="card" id="{{ scope }}finding-{{ row.finding_id }}">
  <div class="row-head">
    <h3>{{ row.title_before }}{% if row.title_ability %}{{ ability(row.ability_id, row.title_ability, row.tooltip) }}{% endif %}{{ row.title_after }}</h3>
    {% if row.seconds %}<span class="cost">{{ row.seconds }}</span>{% endif %}
    <a class="badge {{ row.badge.tint }}" href="#{{ scope }}provenance">{{ row.badge.label }}</a>
  </div>
  {% if row.detail %}
  <p class="detail">{{ row.detail }}</p>
  {% endif %}
  {% if row.nests_inside %}
  <p class="nests">Already counted inside {{ row.nests_inside }}.</p>
  {% endif %}
  {% if row.evidence %}
  <ul class="evidence">{% for item in row.evidence %}<li>{{ item }}</li>{% endfor %}</ul>
  {% endif %}
</div>
{% endmacro %}

{% macro pointer(row) %}
<a class="pointer" href="#{{ scope }}finding-{{ row.finding_id }}">
  <span class="pointer-title">{{ row.title }}</span>
  <span class="cost">{{ row.seconds }}</span>
  <span class="badge {{ row.badge.tint }}">{{ row.badge.label }}</span>
</a>
{% endmacro %}

{# A panel of figures, revealed by CSS alone. `heading` names the panel's
   subject for a surface that does not already show it beside the panel: a
   ledger card's panel hangs off the ability's own name and passes none, a
   timeline row's is laid over a drawing and passes the row's label. Its icon
   rides with it where one resolved, the pairing `ability()` makes for the same
   reason -- the art and the word are one object to a reader -- and it is what
   finds the row again among near-identical grey bars. #}
{%- macro tip(tooltip, heading="", ability_id=None) -%}
<span class="tip" role="note">
{%- if heading %}<span class="tip-head">{% if ability_id in icons_by_id %}<span class="icon i-{{ ability_id }}" aria-hidden="true"></span>{% endif %}{{ heading }}</span>{% endif %}
{%- for line in tooltip.lines %}<span class="tip-line"><span class="tip-label">{{ line.label }}{% if line.tier %} <span class="badge {{ line.tier.tint }}">{{ line.tier.label }}</span>{% endif %}</span><span class="tip-value">{{ line.value }}</span></span>{% endfor %}
{%- if tooltip.note %}<span class="tip-note">{{ tooltip.note }}</span>{% endif %}</span>
{%- endmacro %}

{# One hoverable object per ability: the art and the word are the same thing to a
   reader, so they are the same element to the page. An optional tooltip rides on
   the same element, since that is the one hover target the page already has.
   Spec 4.6 calls the pair "a single hoverable, focusable unit", which a bare
   span cannot be, so it takes a tabindex -- but only when it carries a
   tooltip: an ability with no panel to reveal has nothing for focus to earn,
   and making every one of the page's icons a tab stop would wreck keyboard
   navigation to buy nothing. #}
{% macro ability(ability_id, name, tooltip=None) %}
<span class="ability"{% if tooltip %} tabindex="0"{% endif %}>{% if ability_id in icons_by_id %}<span class="icon i-{{ ability_id }}" aria-hidden="true"></span>{% endif %}<span class="ability-name">{{ name }}</span>
{%- if tooltip %}{{ tip(tooltip) }}{% endif %}</span>
{%- endmacro %}
