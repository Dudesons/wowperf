{# ABOUTME: The two shapes a finding takes on the page: a full card, and a link to one. #}
{# ABOUTME: Each renders whichever fields it is handed; build.py decided what they hold. #}
{% macro ledger_row(row) %}
{% if row.group_note %}
<p class="group-note">{{ row.group_note }}</p>
{% endif %}
<div class="card" id="finding-{{ row.finding_id }}">
  <div class="row-head">
    <h3>{{ row.title_before }}{% if row.title_ability %}{{ ability(row.ability_id, row.title_ability) }}{% endif %}{{ row.title_after }}</h3>
    {% if row.seconds %}<span class="cost">{{ row.seconds }}</span>{% endif %}
    <a class="badge {{ row.badge.tint }}" href="#provenance">{{ row.badge.label }}</a>
  </div>
  {% if row.detail %}
  <p class="detail">{{ row.detail }}</p>
  {% endif %}
  {% if row.nests_inside %}
  <p class="nests">Already counted inside {{ row.nests_inside }}.</p>
  {% endif %}
  {% if row.evidence %}
  <ul class="evidence">{% for item in row.evidence %}<li>{{ item }}</li>{% endfor %}</ul>
  {% endif %}
</div>
{% endmacro %}

{% macro pointer(row) %}
<a class="pointer" href="#finding-{{ row.finding_id }}">
  <span class="pointer-title">{{ row.title }}</span>
  <span class="cost">{{ row.seconds }}</span>
  <span class="badge {{ row.badge.tint }}">{{ row.badge.label }}</span>
</a>
{% endmacro %}

{# One hoverable object per ability: the art and the word are the same thing to a
   reader, so they are the same element to the page. An optional tooltip rides on
   the same element, since that is the one hover target the page already has. #}
{% macro ability(ability_id, name, tooltip=None) %}
<span class="ability">{% if ability_id in icons_by_id %}<span class="icon i-{{ ability_id }}" aria-hidden="true"></span>{% endif %}<span class="ability-name">{{ name }}</span>
{%- if tooltip %}<span class="tip" role="note">
{%- for line in tooltip.lines %}<span class="tip-line"><span class="tip-label">{{ line.label }}</span><span class="tip-value">{{ line.value }}</span></span>{% endfor %}
{%- if tooltip.note %}<span class="tip-note">{{ tooltip.note }}</span>{% endif %}</span>{% endif %}</span>
{%- endmacro %}
