{# ABOUTME: The raid Summary panel: the decomposition ledger, the biggest losses, and what's left. #}
{# ABOUTME: A pointer is a link to a card on another tab, never a second copy of it. #}
{% from "_macros.html.j2" import ledger_row, pointer with context %}
<section class="panel" data-tab-panel="{{ scope }}main" id="{{ scope }}tab-summary">
{% if report.verdict %}
<h2 id="{{ scope }}verdict">Why this attempt ended</h2>
<div class="findings verdict">
{{ ledger_row(report.verdict) }}
</div>
{% endif %}

{% if report.alive_chart %}
<h2 id="{{ scope }}alive">How the attempt went
  <a class="badge {{ report.alive_chart.badge.tint }}" href="#{{ scope }}provenance">{{ report.alive_chart.badge.label }}</a></h2>
<p class="legend">{{ report.alive_chart.legend }} {{ report.alive_chart.boss_note }}</p>
<svg class="alive-chart" width="100%"
     viewBox="0 0 {{ report.alive_chart.width }} {{ report.alive_chart.height }}">
  {% for y, label in report.alive_chart.ticks %}
  <line class="tick" x1="{{ report.alive_chart.tick_x1 }}" y1="{{ y }}"
        x2="{{ report.alive_chart.tick_x2 }}" y2="{{ y }}"></line>
  <text class="tick-label" x="{{ report.alive_chart.tick_label_x }}" y="{{ y }}"
        text-anchor="end" dominant-baseline="middle">{{ label }}</text>
  {% endfor %}
  <polyline class="alive-line" fill="none" points="
    {%- for point in report.alive_chart.points %}{{ point.x }},{{ point.y }} {% endfor -%}
  "></polyline>
</svg>
{% endif %}

{% if report.ledger_decomposition %}
<h2 id="{{ scope }}ledger">Figures that contain others</h2>
<p class="sub">Not additive — every figure below can already contain another, so they must
never be summed.</p>
<div class="findings">
{% for row in report.ledger_decomposition %}
{{ ledger_row(row) }}
{% endfor %}
</div>
{% endif %}

{% if report.summary_pointers %}
<h2 id="{{ scope }}losses">Biggest losses</h2>
<p class="sub">Each line opens its card. Ranked, not additive.</p>
{% for row in report.summary_pointers %}
{{ pointer(row) }}
{% endfor %}
{% endif %}

<h2 id="{{ scope }}observations">Other findings</h2>
{% if report.observations %}
<p class="sub">Findings no other section claimed.</p>
<div class="findings">
{% for row in report.observations %}
{{ ledger_row(row) }}
{% endfor %}
</div>
{% else %}
<p class="sub">Nothing else measured.</p>
{% endif %}

</section>
