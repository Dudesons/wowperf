{# ABOUTME: The Players panel: one card per player, carrying their measured facts. #}
{# ABOUTME: Damage reads against the group median, never as avoidable. #}
{% from "_macros.html.j2" import ability, ledger_row with context %}
{% from "_player_timeline.html.j2" import player_timeline with context %}
<section class="panel" data-tab-panel="main" id="tab-players">

<h2 id="players">Players</h2>
{% if not report.players %}
<p class="sub">No players.</p>
{% endif %}
<nav class="tabs subtabs" data-tab-group="players" aria-label="Players">
{% for player in report.players %}
  <button type="button" class="tab" data-tab-for="player-{{ player.slug }}">{{ player.name }}</button>
{% endfor %}
</nav>
{% for player in report.players %}
<div class="card" data-tab-panel="players" id="player-{{ player.slug }}">
  <div class="player-head">
    <span class="swatch" style="background: var(--{{ player.colour }})"></span>
    <h3>{{ player.name }}</h3>
    <span class="sub">{{ player.class_name }} {{ player.spec }}</span>
  </div>
  <p class="stats">{{ player.stats_line }}</p>
  {{ player_timeline(player.timeline) }}
  {% if player.damage_rows %}
  <div class="findings">
  {% for row in player.damage_rows %}
  {{ ledger_row(row) }}
  {% endfor %}
  </div>
  {% endif %}
  {% if player.spell_and_talent.state.value == "withheld" %}
  <p class="withheld">{{ player.spell_and_talent.reason }}</p>
  {% endif %}
  {% if player.spell_and_talent_rows %}
  <div class="findings">
  {% for row in player.spell_and_talent_rows %}
  {{ ledger_row(row) }}
  {% endfor %}
  </div>
  {% endif %}
  {% for table in player.comparison_tables %}
  <details class="compared">
  <summary>{{ table.heading }}</summary>
  <p class="sub">{{ table.caption }}</p>
  <table class="compared-rows">
    <thead><tr><th scope="col">Ability</th><th scope="col" class="num">Ours</th><th scope="col" class="num">Median</th><th scope="col" class="num">Range</th><th scope="col">Sample</th><th scope="col">Verdict</th></tr></thead>
    <tbody>
    {% for row in table.rows %}
    <tr class="v-{{ row.verdict }}">
      <td>{{ ability(row.ability_id, row.name) }}</td>
      <td class="num">{{ row.ours }}</td>
      <td class="num">{{ row.theirs }}</td>
      <td class="num">{{ row.spread }}</td>
      <td>{{ row.sample }}</td>
      <td>{{ row.verdict_label }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </details>
  {% endfor %}
</div>
{% endfor %}

{% if report.group_rows %}
<p class="sub">Group. Per-player rates, until each finds its player.</p>
<div class="findings">
{% for row in report.group_rows %}
{{ ledger_row(row) }}
{% endfor %}
</div>
{% endif %}

</section>
